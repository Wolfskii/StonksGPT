# Single .env for the whole repo. Copy to .env and fill in.
# Backend and frontend both read from this file (root).

# Database – used by backend and by docker-compose for Postgres + app
POSTGRES_USER=stonks
POSTGRES_PASSWORD=stonks
POSTGRES_DB=stonksgpt
DATABASE_URL=postgresql://stonks:stonks@localhost:5432/stonksgpt

# Market data
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# AI (backend) – set one provider and its key
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Backend server
PORT=3000

# Frontend (Vite) – backend URL for API
VITE_API_URL=http://localhost:3000
